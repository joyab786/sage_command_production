# SageCommand Production - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================
# ENVIRONMENT MODE (Fail-Closed Default is 'production')
# Options: development | test | production
# Local development must explicitly set SAGE_ENV=development
# =============================================================
SAGE_ENV=development

# =============================================================
# REQUIRED: Google Gemini API Key (for the AI agent)
# Get your key at: https://aistudio.google.com/app/apikey
# =============================================================
GOOGLE_API_KEY=your_google_api_key_here

# =============================================================
# REQUIRED: Tavily Web Search API Key (for real-time web search)
# Get your key at: https://app.tavily.com/
# =============================================================
TAVILY_API_KEY=your_tavily_api_key_here

# =============================================================
# OPTIONAL: LangSmith Tracing (for debugging agent runs)
# Get your key at: https://smith.langchain.com/
# =============================================================
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_PROJECT=SageCommand

# =============================================================
# SAGECOMMAND V3 — SECURE DATABASE CONNECTION GATEWAY
# =============================================================
# Network Policy: RESTRICTED | PRIVATE_ALLOWED | INTERNAL_ONLY | ALLOWLIST
SAGE_DB_NETWORK_POLICY=RESTRICTED

# Host Allowlist: Comma-separated list of permitted hostnames, IPs, or CIDR blocks
# In production, empty allowlist fails closed (blocks all non-allowlisted outbound connections).
SAGE_DB_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.0.0/8

# Port Allowlist: Comma-separated list of permitted destination database ports
SAGE_DB_ALLOWED_PORTS=5432,3306,1433

# SSL/TLS Policy: REQUIRED | PREFERRED | DISABLED (DISABLED is blocked in production)
SAGE_DB_SSL_POLICY=REQUIRED

# Gateway Lifecycle Timeouts (in seconds)
SAGE_DB_CONNECTION_TIMEOUT=10
SAGE_DB_IDLE_TIMEOUT=1800
SAGE_DB_MAX_LIFETIME=86400

# Secret Encryption Key (32-byte urlsafe base64 for symmetric credential encryption)
# SAGE_DB_ENCRYPTION_KEY=

# =============================================================
# SAGECOMMAND V3 — ORGANIZATIONAL MEMORY FOUNDATION
# =============================================================
# Database path for governed organizational memory
SAGE_ORGANIZATIONAL_MEMORY_DB_PATH=sage_organizational_memory.sqlite

# Limits and defaults
SAGE_MEMORY_MAX_ENTRY_SIZE_BYTES=1048576
SAGE_MEMORY_MAX_SEARCH_RESULTS=50
SAGE_MEMORY_DEFAULT_SEARCH_LIMIT=10
SAGE_MEMORY_MAX_CONTEXT_ITEMS=10
SAGE_MEMORY_MAX_CONTEXT_TOKENS=4000
SAGE_MEMORY_DEFAULT_RETENTION_POLICY=STANDARD_7_YEARS
 
# =============================================================
# SAGECOMMAND V3 — CLOSED-LOOP LEARNING FOUNDATION (Prompt 37 / Prompt 37A)
# =============================================================
# Explicit opt-in flags (must default to false for startup safety)
SAGE_CLOSED_LOOP_ENABLED=false
SAGE_VERIFICATION_EVENT_TRIGGER_ENABLED=false
# Authorized subscription scopes for event-triggered verification (comma-separated triples tenant:workspace:plant)
# e.g., SAGE_CLOSED_LOOP_SUBSCRIPTION_SCOPES=tenant_alpha:workspace_prod:plant_01
SAGE_CLOSED_LOOP_SUBSCRIPTION_SCOPES=
SAGE_VERIFICATION_EVENT_MAX_AGE_SECONDS=3600
SAGE_VERIFICATION_EVENT_DEDUP_WINDOW_SECONDS=300
SAGE_VERIFICATION_EVENT_MAX_BATCH_SIZE=50

# =============================================================
# SAGECOMMAND V3 — CLOSED-LOOP OUTCOME LEARNING (Prompt 39)
# =============================================================
# Master toggle for outcome evaluation subsystem (defaults to false for startup safety)
SAGE_OUTCOME_EVALUATION_ENABLED=false
SAGE_OUTCOME_EVALUATION_MAX_BATCH_SIZE=50
SAGE_OUTCOME_EVALUATION_MAX_LIST=100
SAGE_OUTCOME_EVALUATION_MIN_SAMPLE_COUNT=5
SAGE_OUTCOME_EVALUATION_MAX_WINDOW_DAYS=90
SAGE_OUTCOME_EVALUATION_MAX_PAYLOAD_BYTES=65536
SAGE_OUTCOME_EVALUATION_CLOCK_SKEW_TOLERANCE_SECONDS=60
