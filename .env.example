# SageCommand Production - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================
# REQUIRED: Google Gemini API Key (for the AI agent)
# Get your key at: https://aistudio.google.com/app/apikey
# =============================================================
GOOGLE_API_KEY=your_google_api_key_here

# =============================================================
# REQUIRED: Tavily Web Search API Key (for real-time web search)
# Get your key at: https://app.tavily.com/
# =============================================================
TAVILY_API_KEY=your_tavily_api_key_here

# =============================================================
# OPTIONAL: LangSmith Tracing (for debugging agent runs)
# Get your key at: https://smith.langchain.com/
# =============================================================
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_PROJECT=SageCommand

# =============================================================
# SAGECOMMAND V3 — SECURE DATABASE CONNECTION GATEWAY
# =============================================================
# Network Policy: RESTRICTED | PRIVATE_ALLOWED | INTERNAL_ONLY | ALLOWLIST
SAGE_DB_NETWORK_POLICY=RESTRICTED

# Host Allowlist: Comma-separated list of permitted hostnames, IPs, or CIDR blocks
# In production, empty allowlist fails closed (blocks all non-allowlisted outbound connections).
SAGE_DB_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.0.0/8

# Port Allowlist: Comma-separated list of permitted destination database ports
SAGE_DB_ALLOWED_PORTS=5432,3306,1433

# SSL/TLS Policy: REQUIRED | PREFERRED | DISABLED (DISABLED is blocked in production)
SAGE_DB_SSL_POLICY=REQUIRED

# Gateway Lifecycle Timeouts (in seconds)
SAGE_DB_CONNECTION_TIMEOUT=10
SAGE_DB_IDLE_TIMEOUT=1800
SAGE_DB_MAX_LIFETIME=86400

# Secret Encryption Key (32-byte urlsafe base64 for symmetric credential encryption)
# SAGE_DB_ENCRYPTION_KEY=
